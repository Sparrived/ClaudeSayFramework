  "scripts": {
    "new": "node scripts/new.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "render": "node scripts/render.mjs",
    "audio": "node scripts/audio.mjs",
    "score": "node scripts/score-report.mjs",
    "cover": "node scripts/cover.mjs",
    "snap": "node scripts/snap.mjs",
    "sheet": "node scripts/sheet.mjs"
  },
  "dependencies": {
    "@fontsource/maple-mono": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.1",
    "d3": "^7.9.0",
    "figlet": "^1.12.0",
    "gsap": "^3.15.0",
    "katex": "^0.19.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "puppeteer-core": "^25.14.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
